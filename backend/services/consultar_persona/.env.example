# Copia a .env SOLAMENTE en tu PC de desarrollo. Nunca subir .env.
PGHOST=127.0.0.1
PGPORT=15432
PGDATABASE=gestion_personas
PGUSER=gestion_api
PGPASSWORD=REEMPLAZAR_POR_CONTRASENA_DE_GESTION_API

# Entra ID: valores de las dos aplicaciones registradas (solo tenant y client ID)
ENTRA_TENANT_ID=REEMPLAZAR_TENANT_GUID
ENTRA_API_CLIENT_ID=REEMPLAZAR_CLIENT_ID_API_GUID
ENTRA_REQUIRED_SCOPE=personas.leer
